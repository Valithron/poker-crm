{
  "name": "brotm-poker-reminders",
  "main": "worker.ts",
  "compatibility_date": "2026-07-21",

  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "vars": {
    "ENVIRONMENT": "production",
    "DELIVERY_MODE": "live",
    "PUBLIC_APP_ORIGIN": "https://poker.brotime719.com",
    "EMAIL_FROM": "BroTM Poker <poker@brotime719.com>"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brotm-poker",
      "database_id": "f7259eae-4d54-4b3a-a15d-5db0d402bc0a",
      "migrations_dir": "./migrations"
    }
  ]
}
